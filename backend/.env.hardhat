# ── Blockchain (Hardhat local) ─────────────────────
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# ⚠️ Preencha após o deploy: npx hardhat run scripts/deploy.js --network hardhat
VEREDICTCHAIN_ADDRESS=

# ── Carteira do Integrador ──────────────────────────
# Use a chave privada #0 do nó Hardhat (primeira conta do `npx hardhat node`)
# Chave padrão: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
INTEGRADOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── Servidor ────────────────────────────────────────
PORT=3000

# ── Autenticação (JWT) ───────────────────────────
# ⚠️ Valor de desenvolvimento local apenas — NUNCA reutilizar em produção.
JWT_SECRET=dev-hardhat-local-nao-usar-em-producao
JWT_EXPIRES_IN=2h

# ── CORS ─────────────────────────────────────────
# Origem(ns) permitida(s) para o frontend, separadas por vírgula.
CORS_ORIGIN=http://localhost:4200
