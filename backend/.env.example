# ═══════════════════════════════════════════════════════
# VeredictChain — Backend Environment
# ═══════════════════════════════════════════════════════
#
# Duas redes suportadas. Use o script na raiz para alternar:
#   ./switch-network.sh hardhat   → rede local de desenvolvimento
#   ./switch-network.sh besu      → rede Besu da disciplina
#
# Ou configure manualmente abaixo:
# ═══════════════════════════════════════════════════════

# ── Blockchain ──────────────────────────────────────
# Hardhat local:  CHAIN_ID=31337
# Besu:           CHAIN_ID=1337
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337
VEREDICTCHAIN_ADDRESS=0x42699A7612A82f1d9C36148af9C77354759b210b

# ── Carteira do Integrador ──────────────────────────
# ⚠️ NUNCA comitar a chave real. Use apenas em .env local.
# Hardhat: usar chave #0 do nó (0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80)
# Besu:    usar chave fornecida em ~/bc101-dev-env/README.md
INTEGRADOR_PRIVATE_KEY=

# ── Servidor ────────────────────────────────────────
PORT=3000
