# ── Blockchain (Besu - disciplina) ─────────────────
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337
VEREDICTCHAIN_ADDRESS=0x42699A7612A82f1d9C36148af9C77354759b210b

# ── Carteira do Integrador ──────────────────────────
# ⚠️ NUNCA comitar a chave real. Use apenas em .env local.
INTEGRADOR_PRIVATE_KEY=

# ── Servidor ────────────────────────────────────────
PORT=3000

# ── Autenticação (JWT) ───────────────────────────
# ⚠️ NUNCA use o valor padrão de JWT_SECRET em produção.
JWT_SECRET=
JWT_EXPIRES_IN=2h

# ── CORS ─────────────────────────────────────────
# Origem(ns) permitida(s) para o frontend, separadas por vírgula.
CORS_ORIGIN=http://localhost:4200
